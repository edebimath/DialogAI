# Copy to deploy/.env and fill in. Never commit the filled-in file.
# Random values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=
JWT_SECRET=
# The first admin, created when the users table is empty (at least 12 characters).
BOOTSTRAP_ADMIN_EMAIL=admin@sirket.local
BOOTSTRAP_ADMIN_PASSWORD=

# Port of the web app on the host.
WEB_PORT=8080

# Models pulled into Ollama on first start.
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3

# cpu everywhere; the GPU override sets cuda.
WHISPER_DEVICE=cpu

# Optional: Gemini as the agent LLM.
GOOGLE_API_KEY=

# Demo APIs (/api/demo) used by the Kargo, Randevu and SSS templates' HTTP Aracı cards.
DEMO_API=false

# Hosts HTTP Aracı may call, JSON list; [] = any host except blocked ones.
# Example: ["crm.sirket.local","*.api.sirket.local"]
HTTP_TOOL_ALLOWED_HOSTS=[]
