# Yerel geliştirme için ayarlar. Bu dosyayı ".env" adıyla kopyalayıp doldurun; ".env" git'e girmez.
# Docker ile kurulumda bu dosya kullanılmaz: deploy/.env.example'a bakın.

# PostgreSQL (pgvector eklentili) bağlantısı.
DATABASE_URL=postgresql+asyncpg://dialogai:SIFRENIZ@127.0.0.1:5432/dialogai
# Testler bu veritabanını her çalıştırmada sıfırlar; geliştirme veritabanını göstermeyin.
TEST_DATABASE_URL=postgresql+asyncpg://dialogai:SIFRENIZ@127.0.0.1:5432/dialogai_test

# Oturum imzalama anahtarı. Rastgele ve uzun olmalı:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Boş kullanıcı tablosunda oluşturulan ilk yönetici (geliştirmede varsayılanları da çalışır).
# BOOTSTRAP_ADMIN_EMAIL=admin@dialogai.local
# BOOTSTRAP_ADMIN_PASSWORD=

# Whisper (konuşma tanıma): NVIDIA ekran kartı yoksa cpu yapın.
# WHISPER_DEVICE=cuda

# Gemini'yi ajan LLM'i olarak kullanmak için (isteğe bağlı).
# GOOGLE_API_KEY=

# HTTP Aracı kartlarının {{ secret.crm_token }} ile kullanacağı gizli değerler.
# SECRET_CRM_TOKEN=
